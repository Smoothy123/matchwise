# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Postgres (read by docker-compose for the db service)
POSTGRES_USER=matchwise
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matchwise

# The app connects to the "db" service inside docker-compose.
# From your host machine, use localhost:5433 instead of db:5432.
DATABASE_URL=postgresql://matchwise:change-me@db:5432/matchwise
TEST_DATABASE_URL=postgresql://matchwise:change-me@db:5432/matchwise_test

LOG_LEVEL=INFO

# LLM: any OpenAI-compatible chat API.
# Gemini (free tier): get a key at https://aistudio.google.com/apikey, keep this base URL,
# then run `docker compose run --rm app python -m matchwise.llm --list-models` and pick a Flash model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1 and an OpenAI key and model.
# Calls are spaced to stay under this rate; free tiers are often around 10 per minute.
LLM_REQUESTS_PER_MINUTE=10
# Retries on 429 / 503 "high demand" (with backoff). Raise it for long eval runs.
LLM_MAX_RETRIES=2
# The model that grades reasons in the evals (python -m evals.judge). Best if it isn't the writer.
# gemini-3.5-flash would be stronger, but its free tier allowed only ~10 requests a day (Nov 2026).
JUDGE_MODEL=gemini-3.1-flash-lite
