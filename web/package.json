{
  "name": "matchwise-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "api:sync": "node scripts/fetch-openapi.mjs && npm run api:types",
    "api:types": "openapi-typescript openapi.json --output src/api/schema.gen.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:live": "npm run build && node scripts/e2e.mjs --live",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@visx/axis": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "cypress": "16.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
